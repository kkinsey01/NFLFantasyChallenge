@section Scripts {
    <script src="~/js/Admin/ManageLineups.js" asp-append-version="true"></script>
}



<div class="mx-auto">
    <div class="d-flex gap-3 align-items-center">
        <h5>Manage Lineups</h5>
        <button id="RefreshTableBtn" class="btn btn-warning">Refresh</button>

        <!--Add a way to filter to only show users with a balance. Also add a search (by name), probably best to do this just in the JS list-->
    </div>    
    <div class="mt-2 mx-2">
        <div>
            <span class="ms-2 fw-bold">Search Names</span>
            <input id="NameSearch" class="form-control in-bg" placeholder="Search by name.." type="search" style="width: 300px;"/>
        </div>       
    </div>
    <div class="mt-4">
        <div>
            <table id="ManageBalanceTable" class="table table-striped" style="overflow: auto; max-height: 300px;">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Balance</th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="ManageBalanceTableBody">

                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="ApproveLineupModal" class="modal fade">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                Approve Lineup
            </div>
            <div class="modal-body" id="ApproveLineupModalBody" style="max-height: 450px; overflow-x: auto;">

            </div>
            <div class="modal-footer">
                <div>
                    <button id="ApproveLineupBtn" class="btn btn-success">Approve</button>
                    <button id="DenyLineupBtn" class="btn btn-danger">Deny</button>
                </div>
            </div>
        </div>
    </div>
</div>

<template id="ManageBalanceRowTemplate">
    <tr>
        <td class="balance-name"></td>
        <td>
            <input type="number" class="form-control in-bg form-control-sm balance-amount" style="width: 80px;"/>
        </td>
        <td>
            <button class="btn btn-success btn-sm update-balance-btn">Update</button>
        </td>
        <td>
            <div class="still-creating" style="display: none;">
                <span>Creating..</span>
            </div>
            <div class="needs-approval" style="display: none;">
                <button class="btn btn-warning btn-sm approve-lineup-btn">Approve</button>
            </div>
            <div class="awaiting-payment" style="display: none;">
                <span>Payment</span>
            </div>
            <div class="already-approved" style="display: none;">
                <span>Approved</span>
            </div>
        </td>
    </tr>
</template>