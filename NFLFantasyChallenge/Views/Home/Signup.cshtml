@section Scripts {
    <script src="~/js/Signup.js"></script>
}

<div class="mx-auto">
    <div class="card">
        <h5 class="card-header">Signup</h5>
        <div class="card-body">
            <form id="SignupForm">
                <div class="d-flex flex-column">
                    <label for="SignupFullName" class="card-text">Full Name</label>
                    <input id="SignupFullName" class="form-control in-bg" type="text" placeholder="Full Name" required />
                </div>
                <div class="d-flex flex-column mt-3">
                    <label for="SignupUsername" class="card-text">Username</label>
                    <input id="SignupUsername" class="form-control in-bg" type="text" placeholder="Username" required />
                </div>
                <div class="d-flex flex-column mt-3">
                    <label for="SignupEmail" class="card-text">Email</label>
                    <input id="SignupEmail" class="form-control in-bg" type="email" placeholder="name@example.com"/>
                </div>
                <div class="d-flex flex-column mt-3">
                    <label for="SignupPassword" class="card-text">Password</label>
                    <input id="SignupPassword" class="form-control in-bg" type="password" placeholder="Password" required />
                </div>
                <div class="d-flex flex-column mt-3">
                    <label for="SignupConfirmPassword" class="card-text">Confirm Password</label>
                    <input id="SignupConfirmPassword" class="form-control in-bg" type="password" placeholder="Password" required />
                </div>

                <div class="d-flex gap-3 mx-auto mt-3">
                    <button id="SignupFormSubmit" class="btn btn-success" type="submit">Signup</button>
                    <button id="SignupFormCancel" class="btn btn-danger">Cancel</button>
                </div>
            </form>            
        </div>
    </div>
</div>